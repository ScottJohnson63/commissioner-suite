// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ──────────────────────────────────────────────────────────────

enum Role {
  COMMISSIONER
  MEMBER
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique @default(cuid())
  email         String?   @unique
  image         String?
  password      String?
  role          Role      @default(MEMBER)
  sleeperUserId String?
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model League {
  id              String           @id @default(cuid())
  sleeperLeagueId String           @unique
  name            String           @default("")
  season          Int
  createdAt       DateTime         @default(now())
  rankedSeasonIds String           @default("[]") // JSON array of Sleeper league IDs already synced for rankings
  teams           Team[]
  schedules       Schedule[]
  auditLogs       AuditLog[]
  rankings        SleeperRanking[]
}

model Team {
  id              String    @id @default(cuid())
  leagueId        String
  sleeperRosterId String
  name            String
  divisionId      Int
  league          League    @relation(fields: [leagueId], references: [id])
  homeMatchups    Matchup[] @relation("HomeTeam")
  awayMatchups    Matchup[] @relation("AwayTeam")

  @@unique([leagueId, sleeperRosterId])
}

model Schedule {
  id          String    @id @default(cuid())
  leagueId    String
  season      Int
  seed        Int
  generatedAt DateTime  @default(now())
  league      League    @relation(fields: [leagueId], references: [id])
  matchups    Matchup[]
}

model Matchup {
  id         String   @id @default(cuid())
  scheduleId String
  week       Int
  homeTeamId String
  awayTeamId String
  type       String
  homePoints Float? // ← new
  awayPoints Float? // ← new
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
}

enum AuditActionType {
  SYNC
  GENERATE
  DELETE
  EXPORT
}

model AuditLog {
  id        String          @id @default(cuid())
  action    AuditActionType
  leagueId  String?
  league    League?         @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  detail    String          @default("{}")
  createdAt DateTime        @default(now())

  @@index([leagueId])
  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  username  String?
  url       String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SleeperRanking {
  id            String   @id @default(cuid())
  leagueId      String
  sleeperUserId String
  displayName   String
  teamName      String?
  totalWins     Int      @default(0)
  totalLosses   Int      @default(0)
  totalTies     Int      @default(0)
  winPct        Float    @default(0)
  seasonsPlayed Int      @default(0)
  syncedAt      DateTime @default(now())
  league        League   @relation(fields: [leagueId], references: [id])

  @@unique([leagueId, sleeperUserId])
  @@index([leagueId, winPct])
}

model SleeperCache {
  key       String   @id // e.g. "nfl_player_map"
  data      String // JSON blob
  fetchedAt DateTime @default(now())
}

// ─── Scheduled External Sync Tracking ─────────────────────────────────────────
//
// Every job that pulls from Sleeper or nflverse and writes to this database
// records one SyncRun row. The Data Sync dashboard tab reads the latest row per
// source to show when each feed last updated and whether it succeeded.

enum SyncSource {
  NFL_WEEKLY
  NFL_SEASON_RESET
  SLEEPER_SCORES
  SLEEPER_RANKINGS
  SLEEPER_LEAGUES
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  // The job ran but intentionally did nothing — e.g. the NFL season window
  // guard rejected it. Distinguished from FAILED so the UI does not alarm.
  SKIPPED
}

model SyncRun {
  id         String     @id @default(cuid())
  source     SyncSource
  status     SyncStatus
  /**
   * "schedule" for cron-triggered runs, "manual" for commissioner-triggered.
   */
  trigger    String     @default("schedule")
  /**
   * Sleeper league this run covered, for the league-scoped feeds. Null means
   * the run was not league-specific: either a global feed (the nflverse jobs
   * pull NFL-wide data) or a scheduled run that swept every league at once.
   * Deliberately not a relation — a run is a historical fact and must survive
   * the league being removed from the app.
   */
  leagueId   String?
  rowCount   Int        @default(0)
  /**
   * Free-form JSON: row counts per league, skip reason, error message.
   */
  detail     String     @default("{}")
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([source, startedAt])
  @@index([source, leagueId, startedAt])
  @@index([startedAt])
}

model NflWeeklyStat {
  id String @id @default(cuid())

  // ── Identity ──────────────────────────────────────
  gameId            String?
  playerId          String
  playerName        String?
  playerDisplayName String?
  position          String?
  positionGroup     String?
  season            Int
  week              Int
  seasonType        String?
  team              String?
  opponentTeam      String?

  // ── Passing ───────────────────────────────────────
  completions            Float?
  attempts               Float?
  passingYards           Float?
  passingTds             Float?
  passingInterceptions   Float?
  sacksSuffered          Float?
  sackYardsLost          Float?
  sackFumbles            Float?
  sackFumblesLost        Float?
  passingAirYards        Float?
  passingYardsAfterCatch Float?
  passingFirstDowns      Float?
  passingEpa             Float?
  passingCpoe            Float?
  passing2ptConversions  Float?
  pacr                   Float?
  passing10              Float?
  passing16              Float?
  passing20              Float?
  passing40              Float?

  // ── Rushing ───────────────────────────────────────
  carries               Float?
  rushingYards          Float?
  rushingTds            Float?
  rushingFumbles        Float?
  rushingFumblesLost    Float?
  rushingFirstDowns     Float?
  rushingEpa            Float?
  rushing2ptConversions Float?
  rushing10             Float?
  rushing12             Float?
  rushing20             Float?
  rushing40             Float?

  // ── Receiving ─────────────────────────────────────
  receptions               Float?
  targets                  Float?
  receivingYards           Float?
  receivingTds             Float?
  receivingFumbles         Float?
  receivingFumblesLost     Float?
  receivingAirYards        Float?
  receivingYardsAfterCatch Float?
  receivingFirstDowns      Float?
  receivingEpa             Float?
  receiving2ptConversions  Float?
  receiving10              Float?
  receiving16              Float?
  receiving20              Float?
  receiving40              Float?
  racr                     Float?
  targetShare              Float?
  airYardsShare            Float?
  wopr                     Float?

  // ── Defense ───────────────────────────────────────
  defTacklesSolo         Float?
  defTacklesWithAssist   Float?
  defTackleAssists       Float?
  defTacklesForLoss      Float?
  defTacklesForLossYards Float?
  defFumblesForced       Float?
  defSacks               Float?
  defSackYards           Float?
  defQbHits              Float?
  defInterceptions       Float?
  defInterceptionYards   Float?
  defPassDefended        Float?
  defTds                 Float?
  defFumbles             Float?
  defSafeties            Float?
  defPuntBlocks          Float?
  defPatBlocks           Float?
  defFgBlocks            Float?
  def2ptAtts             Float?
  def2ptMade             Float?

  // ── Kicking ───────────────────────────────────────
  fgMade            Float?
  fgAtt             Float?
  fgMissed          Float?
  fgBlocked         Float?
  fgLong            Float?
  fgPct             Float?
  fgMade0To19       Float?
  fgMade20To29      Float?
  fgMade30To39      Float?
  fgMade40To49      Float?
  fgMade50To59      Float?
  fgMade60Plus      Float?
  fgMissed0To19     Float?
  fgMissed20To29    Float?
  fgMissed30To39    Float?
  fgMissed40To49    Float?
  fgMissed50To59    Float?
  fgMissed60Plus    Float?
  fgMadeList        String?
  fgMissedList      String?
  fgBlockedList     String?
  fgMadeDistance    Float?
  fgMissedDistance  Float?
  fgBlockedDistance Float?
  patMade           Float?
  patAtt            Float?
  patMissed         Float?
  patBlocked        Float?
  patPct            Float?
  gwfgMade          Float?
  gwfgAtt           Float?
  gwfgMissed        Float?
  gwfgBlocked       Float?
  gwfgDistance      Float?

  // ── Punting ───────────────────────────────────────
  ptAtt         Float?
  ptBlocked     Float?
  ptLong        Float?
  ptYards       Float?
  ptInside20    Float?
  ptOutOfBounds Float?
  ptDowned      Float?
  ptTouchback   Float?
  ptFairCaught  Float?
  ptReturned    Float?
  ptReturnYards Float?
  ptReturnTds   Float?
  ptNetYards    Float?

  // ── Returns / misc ────────────────────────────────
  specialTeamsTds        Float?
  miscYards              Float?
  fumbleRecoveryOwn      Float?
  fumbleRecoveryYardsOwn Float?
  fumbleRecoveryOpp      Float?
  fumbleRecoveryYardsOpp Float?
  fumbleRecoveryTds      Float?
  penalties              Float?
  penaltyYards           Float?
  fumblesForcedByOpp     Float?
  fumblesNotForced       Float?
  fumblesOutOfBounds     Float?
  fumblesTotal           Float?
  fumblesLostTotal       Float?
  puntReturns            Float?
  puntReturnYards        Float?
  kickoffReturns         Float?
  kickoffReturnYards     Float?

  // ── Fantasy ───────────────────────────────────────
  fantasyPoints    Float?
  fantasyPointsPpr Float?
  headshot         String?

  @@unique([season, week, playerId])
  @@index([position, season])
  @@index([team, season])
}
